:34.0676},"easing":"linear","duration":0.299},"dur":0.299},{"id":"ck_30_148400","at":148.101,"op":"animate","args":{"props":{"to":{"position":[0.3363,1.4954,-1.1391]},"lookAt":[0.1107,1.2792,-0.4452],"fov":33.4828},"easing":"linear","duration":0.299},"dur":0.299},{"id":"ck_31_149000","at":148.401,"op":"animate","args":{"props":{"to":{"position":[0.2399,1.4048,-1.0264]},"lookAt":[0.11,1.28,-0.446],"fov":32.3253},"easing":"linear","duration":0.599},"dur":0.599},{"id":"ck_32_149700","at":149.001,"op":"animate","args":{"props":{"to":{"position":[0.1662,1.3334,-0.8737]},"lookAt":[0.11,1.28,-0.446],"fov":31.1873},"easing":"linear","duration":0.699},"dur":0.699},{"id":"ck_33_150100","at":149.701,"op":"animate","args":{"props":{"to":{"position":[0.1397,1.3082,-0.801]},"lookAt":[0.11,1.28,-0.446],"fov":30.7217},"easing":"linear","duration":0.399},"dur":0.399},{"id":"ck_34_150700","at":150.101,"op":"animate","args":{"props":{"to":{"position":[0.1183,1.2877,-0.7182]},"lookAt":[0.11,1.28,-0.446],"fov":30.28},"easing":"linear","duration":0.599},"dur":0.599},{"id":"ck_35_151200","at":150.701,"op":"animate","args":{"props":{"to":{"position":[0.1117,1.2815,-0.6699]},"lookAt":[0.11,1.28,-0.446],"fov":30.0984},"easing":"linear","duration":0.499},"dur":0.499},{"id":"ck_36_152000","at":151.201,"op":"animate","args":{"props":{"to":{"position":[0.11,1.28,-0.636]},"lookAt":[0.11,1.28,-0.446],"fov":30},"easing":"linear","duration":0.799},"dur":0.799},{"id":"ck_37_156500","at":152.001,"op":"animate","args":{"props":{"to":{"position":[0.11,1.28,-0.636]},"lookAt":[0.11,1.28,-0.446],"fov":30},"easing":"linear","duration":4.499},"dur":4.499}]},{"target":".tokyo","events":[{"id":"evmvzqxjy0_1","at":0,"op":"play","args":{"name":"Take 001","loop":true},"dur":10}]}]},"dayLook":{"bg":3023682,"fog":{"type":"Fog","color":3877455,"near":3.5,"far":14}},"renderSubtitles":[{"id":"cue-w5h81j1","start":1,"end":4.5,"text":"[distant city hum]"},{"id":"cue-r8bubm2","start":24,"end":27.5,"text":"[footsteps, a shutter rattles]"},{"id":"cue-hmvr9o3","start":42.5,"end":46,"text":"Third lantern, then left...\nit has to be here."},{"id":"cue-z2x0in4","start":53.2,"end":56.7,"text":"Narrow. Of course it's narrow."},{"id":"cue-7bpt485","start":59,"end":61.7,"text":"Maya? Maya! Over here!"},{"id":"cue-lg89226","start":61.9,"end":65.2,"text":"Nico! I almost walked\nright past you."},{"id":"cue-ptmmjc7","start":67,"end":72.3,"text":"Two years, and you still pick\nthe hardest street in Tokyo to find."},{"id":"cue-870z2w8","start":73,"end":74.9,"text":"Hardest to find,\neasiest to love."},{"id":"cue-mn8zi39","start":75,"end":76.9,"text":"Don't start.\nStill awful coffee?"},{"id":"cue-hwi4jta","start":77,"end":78.9,"text":"Awful. That's why\nit's perfect."},{"id":"cue-qeltlvb","start":79,"end":80.9,"text":"Fine. Make mine\nthe strong one."},{"id":"cue-ffwoz5c","start":81,"end":83.6,"text":"Already done. Sit, sit!"},{"id":"cue-j5m69cd","start":83.9,"end":89.9,"text":"So tell me everything.\nWhat happened to the studio?\nYou just... vanished."},{"id":"cue-a3oem2e","start":95,"end":97.5,"text":"[a cup clinks on its saucer]"},{"id":"cue-lz4nw0f","start":99,"end":103.7,"text":"The lease ended. Everyone said quit.\nSo I bought a coffee machine."},{"id":"cue-i96tr8g","start":105.5,"end":112.2,"text":"A coffee machine. Of course you did.\nAnd people cross the whole city for it?"},{"id":"cue-if9nnph","start":112.4,"end":114.6,"text":"[a bell, far off]"},{"id":"cue-cti5ubi","start":116,"end":118.3,"text":"Only the lost ones."},{"id":"cue-3zbhtej","start":119.6,"end":122.6,"text":"Then I'm in the right place."},{"id":"cue-09eb0nk","start":122.8,"end":125.5,"text":"You always were."},{"id":"cue-9lnecil","start":125.8,"end":136.8,"text":"[both laughing]"},{"id":"cue-cq0gbqm","start":137.8,"end":140.9,"text":"Same time next week?"},{"id":"cue-kyy6nvn","start":142,"end":145.5,"text":"I'll keep the strong one warm."},{"id":"cue-epsov6o","start":146.5,"end":151.5,"text":"[soft music swells]"}]},"layer